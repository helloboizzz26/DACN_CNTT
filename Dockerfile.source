# Local source build for the container runtime monitoring graduation project.
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /src/frontend
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive
COPY frontend/ ./
RUN yarn build

FROM golang:1.26-trixie AS backend-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/container-monitor .

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1234 --create-home monitor
WORKDIR /app
COPY --from=frontend-build /src/frontend/dist ./frontend/dist
COPY --from=backend-build /out/container-monitor ./container-monitor
COPY LICENSE ./LICENSE
USER 1234
EXPOSE 2802
ENTRYPOINT ["./container-monitor"]
